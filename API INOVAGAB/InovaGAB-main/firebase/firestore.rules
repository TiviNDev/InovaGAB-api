rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.perfil;
    }

    function isManagerOrLeader() {
      return getUserRole() in ['manager', 'leader'];
    }

    match /users/{userId} {
      allow read: if isLoggedIn();
      allow create, update: if isLoggedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /ideas/{ideaId} {
      allow read: if isLoggedIn();

      allow create: if isLoggedIn()
        && request.resource.data.autorId == request.auth.uid
        && request.resource.data.status == 'pendente';

      allow update: if isLoggedIn() && isManagerOrLeader();

      allow delete: if isLoggedIn()
        && resource.data.autorId == request.auth.uid;
    }

    match /strategies/{strategyId} {
      allow read: if isLoggedIn();
      allow write: if isLoggedIn() && getUserRole() == 'leader';
    }

    match /projects/{projectId} {
      allow read: if isLoggedIn();
      allow write: if isLoggedIn() && isManagerOrLeader();
    }
  }
}
